# Optional API server settings for deployment platforms.
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# Comma-separated browser origins allowed to call the API.
# Replace these with the exact deployed frontend origin(s) in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

